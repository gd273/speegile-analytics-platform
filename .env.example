# .env.example - DO NOT PUT SECRETS HERE. Commit this file.
# Backend
APP_ENV=development
APP_DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>
JWT_SECRET=replace-me
SUPERSET_INTERNAL_URL=http://superset-web:8088
SUPERSET_EMBED_GUEST_JWT_SECRET=replace-me

# Superset
SECRET_KEY=replace-me
SUPERSET_DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>
GUEST_TOKEN_JWT_SECRET=replace-me
CORS_ALLOW_ORIGINS=http://localhost:3000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPERSET_EMBED_HOST=http://localhost:8088
