# Dockerfile.gateway
FROM nginx:alpine

# 1. Install 'netcat' (nc). 
# We need this tool to ping the other services and see if they are ready.
RUN apk add --no-cache netcat-openbsd

# 2. Setup Config (Same as before)
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

# 3. THE FIX: Smart Startup Command
# This script sits in a loop and asks: "Is backend ready? Is superset ready?"
# It only starts Nginx once they answer "Yes".
CMD ["/bin/sh", "-c", "\
    echo 'Waiting for backend:5000...'; \
    while ! nc -z backend 5000; do sleep 2; done; \
    echo 'Backend is UP!'; \
    echo 'Waiting for superset:8088...'; \
    while ! nc -z superset 8088; do sleep 2; done; \
    echo 'Superset is UP!'; \
    echo 'Starting Nginx...'; \
    nginx -g 'daemon off;'"]